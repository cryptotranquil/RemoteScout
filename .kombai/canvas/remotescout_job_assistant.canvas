      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap');\n@layer components {\n  .msym { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; direction: ltr; -webkit-font-feature-settings: 'liga'; font-feature-settings: 'liga'; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n  .msym-fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n  .no-sb { scrollbar-width: none; }\n  .no-sb::-webkit-scrollbar { display: none; }\n}\n</style>\n<div class=\"min-h-[844px] flex flex-col bg-[#0c0e12] text-[#f8fafc] antialiased\" data-kid=\"1\" data-name=\"app root container\" style=\"font-family:'Manrope',sans-serif\">\n<header class=\"h-14 shrink-0 px-4 flex items-center justify-between bg-[#111317] border-b border-[#1e2229]\" data-kid=\"1-1\" data-name=\"top header bar\">\n<div class=\"flex items-center gap-2 min-w-0\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n<div class=\"w-8 h-8 rounded-[8px] bg-[#0d9488] flex items-center justify-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"logomark container\">\n<span class=\"msym text-[18px] text-[#04201f]\" data-kid=\"1-1-1-1-1\" data-name=\"radar logo icon\">radar</span>\n</div>\n<div class=\"flex flex-col min-w-0\" data-kid=\"1-1-1-2\" data-name=\"brand text group\">\n<span class=\"text-[16px] leading-[22px] font-semibold tracking-tight truncate\" data-kid=\"1-1-1-2-1\" data-name=\"app name label\">RemoteScout</span>\n<span class=\"text-[10px] leading-[12px] font-medium text-[#94a3b8]\" data-kid=\"1-1-1-2-2\" data-name=\"feed last-sync timestamp\">Sync: 12m ago</span>\n</div>\n</div>\n<div class=\"flex items-center gap-2 shrink-0\" data-kid=\"1-1-2\" data-name=\"header right cluster\">\n<span aria-hidden=\"true\" class=\"w-2 h-2 rounded-full bg-[#14b8a6]\" data-kid=\"1-1-2-1\" data-name=\"live status indicator dot\"></span>\n<img alt=\"Elena Vance profile photo\" class=\"w-8 h-8 rounded-full object-cover ring-1 ring-[#262a34]\" data-kid=\"1-1-2-2\" data-name=\"user profile avatar\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/64?u=elena-vance\"/>\n</div>\n</header>\n<main class=\"flex-1 flex flex-col gap-3 px-4 pt-2 pb-3\" data-kid=\"1-2\" data-name=\"main feed content area\">\n<div class=\"flex flex-col gap-0.5\" data-kid=\"1-2-1\" data-name=\"feed heading block\">\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-1-1\" data-name=\"feed title row\">\n<span class=\"text-[13px] leading-4 font-semibold\" data-kid=\"1-2-1-1-1\" data-name=\"feed section title\">Today's Recommendations</span>\n<span class=\"inline-flex items-center gap-1 text-[11px] leading-[14px] font-semibold text-[#2dd4bf]\" data-kid=\"1-2-1-1-2\" data-name=\"curated feed badge\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-1-2-1\" data-name=\"badge status dot\"></span>Curated for You\n        </span>\n</div>\n<p class=\"text-[12px] leading-4 text-[#94a3b8]\" data-kid=\"1-2-1-2\" data-name=\"date and match count subtitle\">Wednesday, Oct 24 • 8 new qualified matches</p>\n</div>\n<div class=\"overflow-x-auto no-sb -mx-4 px-4 flex items-center gap-1 py-0.5\" data-kid=\"1-2-2\" data-name=\"horizontal scrollable filter bar\">\n<button class=\"shrink-0 h-8 px-3 rounded-[8px] bg-[#0d9488] text-white text-[11px] leading-[14px] font-semibold flex items-center justify-center\" data-kid=\"1-2-2-1\" data-name=\"active filter chip\" type=\"button\">All Roles</button>\n<button class=\"shrink-0 h-8 px-3 rounded-[8px] bg-[#181a20] border border-[#262a34] text-[#94a3b8] text-[11px] leading-[14px] font-semibold flex items-center justify-center\" data-kid=\"1-2-2-2\" data-name=\"inactive role filter chip\" type=\"button\">Staff / Lead</button>\n<button class=\"shrink-0 h-8 px-3 rounded-[8px] bg-[#181a20] border border-[#262a34] text-[#94a3b8] text-[11px] leading-[14px] font-semibold flex items-center justify-center\" data-kid=\"1-2-2-3\" data-name=\"inactive salary filter chip\" type=\"button\">$160k+</button>\n<button class=\"shrink-0 h-8 px-3 rounded-[8px] bg-[#181a20] border border-[#262a34] text-[#94a3b8] text-[11px] leading-[14px] font-semibold flex items-center justify-center\" data-kid=\"1-2-2-4\" data-name=\"inactive timezone filter chip\" type=\"button\">North America / Any Timezone</button>\n</div>\n<div class=\"flex flex-col gap-2\" data-kid=\"1-2-3\" data-name=\"job cards list\">\n<article class=\"bg-[#181a20] border border-[#262a34] rounded-[8px] p-3 flex flex-col gap-2\" data-kid=\"1-2-3-1\" data-name=\"job recommendation card\">\n<div class=\"flex items-center justify-between gap-1\" data-kid=\"1-2-3-1-1\" data-name=\"card header row\">\n<div class=\"flex items-center gap-1 min-w-0\" data-kid=\"1-2-3-1-1-1\" data-name=\"company identity group\">\n<div class=\"w-6 h-6 rounded-[6px] bg-[#222631] border border-[#2c3240] flex items-center justify-center shrink-0\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"company logo tile\">\n<span class=\"text-[11px] leading-none font-semibold text-[#5eead4]\" data-kid=\"1-2-3-1-1-1-1-1\" data-name=\"monogram letter\">L</span>\n</div>\n<span class=\"text-[15px] leading-5 font-semibold text-[#94a3b8] truncate\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"company name label\">Linear Labs</span>\n<span class=\"text-[#64748b] text-[10px] leading-3\" data-kid=\"1-2-3-1-1-1-3\" data-name=\"monogram separator dot\">•</span>\n<span class=\"text-[10px] leading-3 font-medium text-[#94a3b8] truncate\" data-kid=\"1-2-3-1-1-1-4\" data-name=\"job source label\">Direct Careers</span>\n</div>\n<span class=\"text-[10px] leading-3 font-medium text-[#94a3b8] shrink-0\" data-kid=\"1-2-3-1-1-2\" data-name=\"posting elapsed time\">3h ago</span>\n</div>\n<div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-1-2\" data-name=\"job title block\">\n<h2 class=\"text-[18px] leading-6 font-semibold tracking-tight\" data-kid=\"1-2-3-1-2-1\" data-name=\"job title heading\">Staff Product Designer, Systems &amp; AI</h2>\n<div class=\"flex flex-wrap items-center gap-1.5 pt-0.5\" data-kid=\"1-2-3-1-2-2\" data-name=\"job tag chips row\">\n<span class=\"h-[22px] px-2 rounded-[3px] bg-[#0f3d3e] border border-[#1a4a4b] text-[#2dd4bf] text-[11px] leading-[14px] font-semibold inline-flex items-center\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"match rate chip\" data-reason=\"match percentage derived from script scoring\">94% Match • High Fit</span>\n<span class=\"h-[22px] px-2 rounded-[3px] bg-[#1e2229] border border-[#2c3240] text-[#94a3b8] text-[11px] leading-[14px] font-semibold inline-flex items-center\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"remote location chip\">Full Remote (US/EU)</span>\n</div>\n</div>\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-3-1-3\" data-name=\"salary row\">\n<span class=\"text-[14px] leading-5 font-semibold text-[#14b8a6]\" data-kid=\"1-2-3-1-3-1\" data-name=\"salary range text\">$175,000 – $210,000 USD</span>\n<span class=\"text-[11px] leading-4 text-[#94a3b8] shrink-0 whitespace-nowrap\" data-kid=\"1-2-3-1-3-2\" data-name=\"additional comp note\">+ Equity grants</span>\n</div>\n<div class=\"bg-[#131f24] border border-[#1a383d] rounded-[8px] p-2.5 flex items-start gap-2\" data-kid=\"1-2-3-1-4\" data-name=\"match reason callout\">\n<span class=\"msym msym-fill text-[16px] text-[#2dd4bf] shrink-0 mt-0.5\" data-kid=\"1-2-3-1-4-1\" data-name=\"sparkle match icon\">auto_awesome</span>\n<p class=\"text-[12px] leading-4 text-[#5eead4]\" data-kid=\"1-2-3-1-4-2\" data-name=\"match reason text\">Matches your seniority, Figma/Design Systems depth, and async culture preference.</p>\n</div>\n<di
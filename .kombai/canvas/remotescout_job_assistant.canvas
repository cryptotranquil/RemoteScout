-kid=\"1-2-5-1-2\" data-name=\"batch actions buttons group\">\n<button class=\"h-7 px-2.5 bg-white text-[#141b2b] text-[10px] leading-3 font-medium rounded-[8px] inline-flex items-center gap-1\" data-kid=\"1-2-5-1-2-1\" data-name=\"export csv button\" type=\"button\">\n<span class=\"msym text-[13px] text-[#016a6a]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"download icon\">download</span>Export CSV\n          </button>\n<button class=\"h-7 px-2.5 bg-white text-[#141b2b] text-[10px] leading-3 font-medium rounded-[8px] inline-flex items-center gap-1\" data-kid=\"1-2-5-1-2-2\" data-name=\"manage tags button\" type=\"button\">\n<span class=\"msym text-[13px] text-[#016a6a]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"tags icon\">sell</span>Manage Tags\n          </button>\n</div>\n</div>\n</div>\n</main>\n<nav class=\"h-14 shrink-0 px-4 flex items-center justify-around bg-[#f9f9ff] border-t border-[#e1e8fd]\" data-kid=\"1-3\" data-name=\"bottom tab navigation bar\">\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-1\" data-name=\"discover tab link\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-1-1\" data-name=\"explore icon\">explore</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-1-2\" data-name=\"discover tab label\">Discover</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#005454]\" data-kid=\"1-3-2\" data-name=\"saved tab link\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-2-1\" data-name=\"bookmark icon\">bookmark</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-2-2\" data-name=\"saved tab label\">Saved</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-3\" data-name=\"applications tab link\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-3-1\" data-name=\"work icon\">work</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-3-2\" data-name=\"applications tab label\">Applications</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-4\" data-name=\"profile tab link\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-4-1\" data-name=\"tune icon\">tune</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-4-2\" data-name=\"profile tab label\">Profile</span>\n</a>\n</nav>\n</div>",

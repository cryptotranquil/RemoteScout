ion\">\n<div class=\"w-8 h-8 rounded-full bg-[#f1f3ff] flex items-center justify-center mb-1 text-[#3e4948]\" data-kid=\"1-2-6-1\" data-name=\"confirmation icon circle\">\n<span class=\"msym text-[18px]\" data-kid=\"1-2-6-1-1\" data-name=\"check circle icon\">check_circle</span>\n</div>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-6-2\" data-name=\"confirmation message text\">All pipeline events synced with calendar</span>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]/70\" data-kid=\"1-2-6-3\" data-name=\"agent status text\">RemoteScout personal agent active</span>\n</div>\n</main>\n<nav class=\"h-14 shrink-0 px-4 flex items-center justify-around bg-[#f9f9ff] border-t border-[#e1e8fd]\" data-kid=\"1-3\" data-name=\"bottom navigation bar\">\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-1\" data-name=\"discover nav tab\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-1-1\" data-name=\"explore icon\">explore</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-1-2\" data-name=\"discover label\">Discover</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-2\" data-name=\"saved nav tab\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-2-1\" data-name=\"bookmark icon\">bookmark</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-2-2\" data-name=\"saved label\">Saved</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#005454]\" data-kid=\"1-3-3\" data-name=\"applications active nav tab\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-3-1\" data-name=\"work icon\">work</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-3-2\" data-name=\"applications label\">Applications</span>\n</a>\n<a class=\"flex flex-col items-center justify-center gap-0.5 min-w-[56px] min-h-[44px] text-[#3e4948]\" data-kid=\"1-3-4\" data-name=\"profile nav tab\" href=\"#\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-4-1\" data-name=\"tune icon\">tune</span><span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-3-4-2\" data-name=\"profile label\">Profile</span>\n</a>\n</nav>\n</div>",

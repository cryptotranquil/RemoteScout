      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap');\n@layer components {\n  .msym { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; direction: ltr; -webkit-font-feature-settings: 'liga'; font-feature-settings: 'liga'; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n  .msym-fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n}\n</style>\n<div class=\"min-h-[844px] flex flex-col bg-[#f9f9ff] text-[#141b2b] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Manrope',sans-serif\">\n<header class=\"h-14 shrink-0 px-4 flex items-center justify-between bg-[#f9f9ff]/90\" data-kid=\"1-1\" data-name=\"app top header bar\">\n<div class=\"flex items-center gap-1.5 min-w-0\" data-kid=\"1-1-1\" data-name=\"header title group container\">\n<button aria-label=\"Go back\" class=\"min-w-[40px] min-h-[44px] -ml-2 flex items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"back navigation button\" type=\"button\">\n<span class=\"msym text-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"arrow back icon\">arrow_back</span>\n</button>\n<div class=\"w-7 h-7 rounded-[6px] bg-[#005454] flex items-center justify-center shrink-0\" data-kid=\"1-1-1-2\" data-name=\"app logo badge container\">\n<span class=\"msym text-[16px] text-white\" data-kid=\"1-1-1-2-1\" data-name=\"radar logo icon\">radar</span>\n</div>\n<h1 class=\"text-[16px] leading-[22px] font-semibold truncate ml-1\" data-kid=\"1-1-1-3\" data-name=\"page title text\">Criteria Setup</h1>\n</div>\n<img alt=\"Elena Vance profile photo\" class=\"w-8 h-8 rounded-full object-cover shrink-0\" data-kid=\"1-1-2\" data-name=\"user profile avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/64?u=elena-vance\"/>\n</header>\n<main class=\"flex-1 flex flex-col px-4 pt-3 pb-6 gap-4\" data-kid=\"1-2\" data-name=\"main content column\">\n<div class=\"flex flex-col gap-1\" data-kid=\"1-2-1\" data-name=\"stepper progress section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-2-1-1\" data-name=\"stepper labels row\">\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#3e4948] uppercase tracking-wider\" data-kid=\"1-2-1-1-1\" data-name=\"step indicator label\">Step 3 of 5 • Criteria Setup</span>\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#0d6e6e]\" data-kid=\"1-2-1-1-2\" data-name=\"progress completion percentage label\">60% Complete</span>\n</div>\n<div class=\"flex items-center gap-1.5 w-full mt-1\" data-kid=\"1-2-1-2\" data-name=\"progress step segment row\">\n<div class=\"h-1.5 flex-1 bg-[#0d6e6e] rounded-[2px]\" data-kid=\"1-2-1-2-1\" data-name=\"progress step segment completed\"></div>\n<div class=\"h-1.5 flex-1 bg-[#0d6e6e] rounded-[2px]\" data-kid=\"1-2-1-2-2\" data-name=\"progress step segment completed\"></div>\n<div class=\"h-1.5 flex-1 bg-[#0d6e6e] rounded-[2px]\" data-kid=\"1-2-1-2-3\" data-name=\"progress step segment completed\"></div>\n<div class=\"h-1.5 flex-1 bg-[#dce2f7] rounded-[2px]\" data-kid=\"1-2-1-2-4\" data-name=\"progress step segment pending\"></div>\n<div class=\"h-1.5 flex-1 bg-[#dce2f7] rounded-[2px]\" data-kid=\"1-2-1-2-5\" data-name=\"progress step segment pending\"></div>\n</div>\n</div>\n<div class=\"flex flex-col gap-1\" data-kid=\"1-2-2\" data-name=\"headline and description group\">\n<h2 class=\"text-[22px] leading-7 font-semibold tracking-tight\" data-kid=\"1-2-2-1\" data-name=\"section headline text\">Define your scout criteria</h2>\n<p class=\"text-[13px] leading-[18px] text-[#3e4948]\" data-kid=\"1-2-2-2\" data-name=\"section description text\">RemoteScout filters out 95% of noise to find roles that strictly match your expectations.</p>\n</div>\n<div class=\"flex items-center justify-between px-3 py-2 bg-[#f1f3ff] rounded-[12px] gap-2\" data-kid=\"1-2-3\" data-name=\"estimated pipeline info banner\">\n<div class=\"flex items-center gap-1\" data-kid=\"1-2-3-1\" data-name=\"pipeline label group\">\n<span class=\"msym msym-fill text-[18px] text-[#005454]\" data-kid=\"1-2-3-1-1\" data-name=\"radar icon\">radar</span>\n<span class=\"text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-1-2\" data-name=\"pipeline label text\">Estimated Live Pipeline</span>\n</div>\n<span class=\"text-[13px] leading-4 font-semibold text-[#005454] px-1.5 py-0.5 bg-[#a0f0f0] rounded-[2px]\" data-kid=\"1-2-3-2\" data-name=\"matching roles count badge\">42 matching roles</span>\n</div>\n<section class=\"flex flex-col gap-1\" data-kid=\"1-2-4\" data-name=\"target roles section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-2-4-1\" data-name=\"target roles header row\">\n<label class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-4-1-1\" data-name=\"target roles field label\">Target Roles</label>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-4-1-2\" data-name=\"multi-select hint label\">Multi-select</span>\n</div>\n<p class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-4-2\" data-name=\"target roles helper text\">Select specific titles you want the background engine to crawl.</p>\n<div class=\"flex flex-wrap gap-2 pt-1\" data-kid=\"1-2-4-3\" data-name=\"role chip container\">\n<button class=\"flex items-center gap-1.5 px-3 py-2 bg-[#0d6e6e] text-white rounded-[12px] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-3-1\" data-name=\"selected role chip Staff Product Designer\" type=\"button\">\n<span class=\"msym text-[15px]\" data-kid=\"1-2-4-3-1-1\" data-name=\"checkmark icon\">check</span><span data-kid=\"1-2-4-3-1-2\" data-name=\"role chip label Staff Product Designer\">Staff Product Designer</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3 py-2 bg-[#0d6e6e] text-white rounded-[12px] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-3-2\" data-name=\"selected role chip Design Systems Lead\" type=\"button\">\n<span class=\"msym text-[15px]\" data-kid=\"1-2-4-3-2-1\" data-name=\"checkmark icon\">check</span><span data-kid=\"1-2-4-3-2-2\" data-name=\"role chip label Design Systems Lead\">Design Systems Lead</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3 py-2 bg-[#e9edff] text-[#141b2b] rounded-[12px] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-3-3\" data-name=\"unselected role chip Product Designer\" type=\"button\">\n<span class=\"msym text-[15px] opacity-40\" data-kid=\"1-2-4-3-3-1\" data-name=\"add plus icon\">add</span><span data-kid=\"1-2-4-3-3-2\" data-name=\"role chip label Product Designer\">Product Designer</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3 py-2 bg-[#e9edff] text-[#141b2b] rounded-[12px] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-3-4\" data-name=\"unselected role chip UX Researcher\" type=\"button\">\n<span class=\"msym text-[15px] opacity-40\" data-kid=\"1-2-4-3-4-1\" data-name=\"add plus icon\">add</span><span data-kid=\"1-2-4-3-4-2\" data-name=\"role chip label UX Researcher\">UX Researcher</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3 py-2 bg-[#e9edff] text-[#141b2b] rounded-[12px] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-3-5\" data-name=\"unselected role chip Design Engineer\" type=\"button\">\n<span class=\"msym text-[15px] opacity-40\" data-kid=\"1-2-4-3-5-1\" data-name=\"add plus icon\">add</span><span data-kid=\"1-2-4-3-5-2\" data-name=\"role chip label Design Engineer\">Design Engineer</span>\n</button>\n</div>\n</section>\n<section class=\"flex flex-col gap-1\" data-kid=\"1-2-5\" data-name=\"experience level section\">\n<label class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-5-1\" data-name=\"experience level field label\">Experience Level</label>\n<div class=\"flex flex-col gap-2 pt-1\" data-kid=\"1-2-5-2\" data-name=\"experience level options container\">\n<div class=\"flex items-center justify-between p-3 rounded-[12px] bg-[#f1f3ff]\" data-kid=\"1-2-5-2-1\" data-name=\"mid-level option row false\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-5-2-1-1\" data-name=\"mid-level option selection group\">\n<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-[#e9edff]\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"unselected radio circle\"></span>\n<span class=\"text-[13px] leading-[18px] font-medium\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"mid-level option label\">Mid-level (3–5 yrs)</span>\n</div>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-5-2-1-2\" data-name=\"Standard tier tag\">Standard</span>\n</div>\n<div class=\"flex items-center justify-between p-3 rounded-[12px] bg-[#dce2f7]\" data-kid=\"1-2-5-2-2\" data-name=\"selected senior option row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-5-2-2-1\" data-name=\"selected option selection group\">\n<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-[#0d6e6e]\" data-kid=\"1-2-5-2-2-1-1\" data-name=\"selected radio circle\">\n<span class=\"msym text-[14px] text-white\" data-kid=\"1-2-5-2-2-1-1-1\" data-name=\"checkmark icon\">check</span>\n</span>\n<span class=\"text-[13px] leading-[18px] font-semibold\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"senior option label\">Senior / Staff (6–10+ yrs)</span>\n</div>\n<span class=\"text-[10px] leading-3 font-semibold px-2 py-0.5 rounded-[2px] bg-[#a0f0f0] text-[#005454]\" data-kid=\"1-2-5-2-2-2\" data-name=\"selected tag badge\">Selected</span>\n</div>\n<div class=\"flex items-center justify-between p-3 rounded-[12px] bg-[#f1f3ff]\" data-kid=\"1-2-5-2-3\" data-name=\"principal option row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-5-2-3-1\" data-name=\"unselected option selection group\">\n<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-[#e9edff]\" data-kid=\"1-2-5-2-3-1-1\" data-name=\"unselected radio circle\"></span>\n<span class=\"text-[13px] leading-[18px] font-medium\" data-kid=\"1-2-5-2-3-1-2\" data-name=\"principal option label\">Principal / Director (10+ yrs)</span>\n</div>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-5-2-3-2\" data-name=\"Leadership tier tag\">Leadership</span>\n</div>\n</div>\n</section>\n<section class=\"flex flex-col gap-1\" data-kid=\"1-2-6\" data-name=\"compensation floor section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-2-6-1\" data-name=\"compensation field header row\">\n<label class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-6-1-1\" data-name=\"compensation floor field label\">Compensation Floor</label>\n<span class=\"text-[10px] leading-3 font-medium text-[#005454]\" data-kid=\"1-2-6-1-2\" data-name=\"strict cutoff tag\">Strict Cutoff</span>\n</div>\n<div class=\"flex items-center bg-white rounded-[12px] px-3 py-2.5 mt-1 gap-2\" data-kid=\"1-2-6-2\" data-name=\"salary input row\">\n<span class=\"msym text-[20px] text-[#3e4948]\" data-kid=\"1-2-6-2-1\" data-name=\"payments icon\">payments</span>\n<input aria-label=\"Minimum annual salary floor\" class=\"w-full min-w-0 bg-transparent text-[15px] leading-5 font-semibold outline-none\" data-kid=\"1-2-6-2-2\" data-name=\"salary floor input field\" type=\"text\" value=\"$150,000 USD / year\"/>\n<button class=\"px-2 py-1 bg-[#e9edff] text-[#3e4948] rounded-[2px] text-[10px] leading-3 font-medium shrink-0\" data-kid=\"1-2-6-2-3\" data-name=\"edit salary button\" type=\"button\">Edit</button>\n</div>\n<label class=\"flex items-start gap-3 mt-2\" data-kid=\"1-2-6-3\" data-name=\"exclude unlisted salary checkbox label\">\n<span class=\"flex items-center justify-center w-5 h-5 mt-0.5 rounded-[4px] bg-[#0d6e6e] shrink-0\" data-kid=\"1-2-6-3-1\" data-name=\"checked checkbox\">\n<span class=\"msym text-[16px] text-white\" data-kid=\"1-2-6-3-1-1\" data-name=\"checkmark icon\">check</span>\n</span>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-6-3-2\" data-name=\"exclude unlisted salary description\">Exclude postings with unlisted salary unless algorithmic verification predicts &gt;$150k USD.</span>\n</label>\n</section>\n<section class=\"flex flex-col gap-1\" data-kid=\"1-2-7\" data-name=\"remote and geographic constraints section\">\n<label class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-7-1\" data-name=\"remote constraints field label\">Remote &amp; Geographic Constraints</label>\n<div class=\"flex flex-col gap-2 pt-1\" data-kid=\"1-2-7-2\" data-name=\"remote constraint options container\">\n<div class=\"flex items-center justify-between p-3 rounded-[12px] bg-[#dce2f7] gap-2\" data-kid=\"1-2-7-2-1\" data-name=\"selected anywhere remote option row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-7-2-1-1\" data-name=\"selected option selection group\">\n<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-[#0d6e6e] shrink-0\" data-kid=\"1-2-7-2-1-1-1\" data-name=\"selected radio circle\">\n<span class=\"msym text-[14px] text-white\" data-kid=\"1-2-7-2-1-1-1-1\" data-name=\"checkmark icon\">check</span>\n</span>\n<div class=\"flex flex-col\" data-kid=\"1-2-7-2-1-1-2\" data-name=\"option text group\">\n<span class=\"text-[13px] leading-[18px] font-semibold\" data-kid=\"1-2-7-2-1-1-2-1\" data-name=\"anywhere remote option label\">100% Anywhere Remote</span>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-7-2-1-1-2-2\" data-name=\"anywhere remote option description\">Global contract or entity anywhere</span>\n</div>\n</div>\n<span class=\"msym text-[20px] text-[#005454]\" data-kid=\"1-2-7-2-1-2\" data-name=\"globe icon\">public</span>\n</div>\n<div class=\"flex items-center justify-between p-3 rounded-[12px] bg-[#f1f3ff] gap-2\" data-kid=\"1-2-7-2-2\" data-name=\"unselected US timezones option row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-7-2-2-1\" data-name=\"unselected option selection group\">\n<span class=\"flex items-center justify-center w-5 h-5 rounded-full bg-[#e9edff] shrink-0\" data-kid=\"1-2-7-2-2-1-1\" data-name=\"unselected radio circle\"></span>\n<div class=\"flex flex-col\" data-kid=\"1-2-7-2-2-1-2\" data-name=\"option text group\">\n<span class=\"text-[13px] leading-[18px] font-medium\" data-kid=\"1-2-7-2-2-1-2-1\" data-name=\"US timezones option label\">US / North America Timezones only</span>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-7-2-2-1-2-2\" data-name=\"US timezones option description\">Synchronous ±3 hours core alignment</span>\n</div>\n</div>\n<span class=\"msym text-[20px] text-[#6e7979]\" data-kid=\"1-2-7-2-2-2\" data-name=\"schedule icon\">schedule</span>\n</div>\n</div>\n</section>\n<section class=\"flex flex-col gap-1\" data-kid=\"1-2-8\" data-name=\"notification and scout cadence section\">\n<label class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-8-1\" data-name=\"notification frequency field label\">Notification &amp; Scout Cadence</label>\n<div class=\"flex flex-col gap-2 pt-1\" data-kid=\"1-2-8-2\" data-name=\"cadence options container\">\n<div class=\"flex items-start gap-3 p-3 rounded-[12px] bg-[#dce2f7]\" data-kid=\"1-2-8-2-1\" data-name=\"selected morning digest option row\">\n<span class=\"mt-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-[#0d6e6e] text-white shrink-0\" data-kid=\"1-2-8-2-1-1\" data-name=\"selected radio circle\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-8-2-1-1-1\" data-name=\"checkmark icon\">check</span>\n</span>\n<div class=\"flex flex-col flex-1 gap-0.5\" data-kid=\"1-2-8-2-1-2\" data-name=\"option content group\">\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-8-2-1-2-1\" data-name=\"option title row\">\n<span class=\"text-[13px] leading-[18px] font-semibold\" data-kid=\"1-2-8-2-1-2-1-1\" data-name=\"morning digest option label\">One calm morning digest</span>\n<span class=\"text-[10px] leading-3 font-semibold px-1.5 py-0.5 rounded-[2px] bg-[#a0f0f0] text-[#005454]\" data-kid=\"1-2-8-2-1-2-1-2\" data-name=\"recommended tag badge\">Recommended</span>\n</div>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-8-2-1-2-2\" data-name=\"morning digest option description\">Delivered at 08:30 AM in your local timezone. Zero midday interruptions.</span>\n</div>\n</div>\n<div class=\"flex items-start gap-3 p-3 rounded-[12px] bg-[#f1f3ff]\" data-kid=\"1-2-8-2-2\" data-name=\"unselected real-time alerts option row\">\n<span class=\"mt-0.5 flex items-center justify-center w-5 h-5 rounded-full bg-[#e9edff] shrink-0\" data-kid=\"1-2-8-2-2-1\" data-name=\"unselected radio circle\"></span>\n<div class=\"flex flex-col flex-1 gap-0.5\" data-kid=\"1-2-8-2-2-2\" data-name=\"option content group\">\n<span class=\"text-[13px] leading-[18px] font-medium\" data-kid=\"1-2-8-2-2-2-1\" data-name=\"real-time alerts option label\">Real-time alerts for &gt;90% matches</span>\n<span class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-8-2-2-2-2\" data-name=\"real-time alerts option description\">Instant ping only when high-signal criteria are impeccably satisfied.</span>\n</div>\n</div>\n</div>\n</section>\n<div class=\"flex flex-col gap-3 pt-1\" data-kid=\"1-2-9\" data-name=\"action buttons and disclaimer group\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-9-1\" data-name=\"action buttons row\">\n<button class=\"h-11 px-4 rounded-[12px] bg-[#e9edff] text-[13px] leading-4 font-semibold\" data-kid=\"1-2-9-1-1\" data-name=\"back navigation button\" type=\"button\">Back</button>\n<button class=\"h-11 flex-1 flex items-center justify-center gap-2 rounded-[12px] bg-[#0d6e6e] text-white text-[13px] leading-4 font-semibold\" data-kid=\"1-2-9-1-2\" data-name=\"primary save and generate button\" type=\"button\">\n<span data-kid=\"1-2-9-1-2-1\" data-name=\"save and generate button label\">Save &amp; Generate Recommendations</span>\n<span class=\"msym text-[18px]\" data-kid=\"1-2-9-1-2-2\" data-name=\"arrow forward icon\">arrow_forward</span>\n</button>\n</div>\n<div class=\"flex items-center gap-2 px-1 py-1\" data-kid=\"1-2-9-2\" data-name=\"privacy disclaimer group\">\n<span class=\"msym msym-fill text-[16px] text-[#005454] shrink-0\" data-kid=\"1-2-9-2-1\" data-name=\"lock shield icon\">lock</span>\n<p class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-9-2-2\" data-name=\"privacy disclaimer text\">Your data stays on device. RemoteScout never contacts recruiters without your explicit action.</p>\n</div>\n</div>\n</main>\n</div>",

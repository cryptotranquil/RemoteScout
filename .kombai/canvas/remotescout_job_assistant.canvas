      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap');\n@layer components {\n  .msym { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; direction: ltr; -webkit-font-feature-settings: 'liga'; font-feature-settings: 'liga'; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n  .msym-fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n}\n</style>\n<div class=\"min-h-[844px] flex flex-col bg-[#f9f9ff] text-[#141b2b] antialiased\" data-kid=\"1\" data-name=\"app shell container\" style=\"font-family:'Manrope',sans-serif\">\n<header class=\"h-14 shrink-0 px-4 flex items-center justify-between bg-[#f9f9ff]/90\" data-kid=\"1-1\" data-name=\"app top header bar\">\n<div class=\"flex items-center gap-1.5 min-w-0\" data-kid=\"1-1-1\" data-name=\"header back-and-title group\">\n<button aria-label=\"Go back\" class=\"min-w-[40px] min-h-[44px] -ml-2 flex items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"back navigation button\" type=\"button\">\n<span class=\"msym text-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"arrow back icon\">arrow_back</span>\n</button>\n<div class=\"w-7 h-7 rounded-[6px] bg-[#005454] flex items-center justify-center shrink-0\" data-kid=\"1-1-1-2\" data-name=\"brand logo badge\">\n<span class=\"msym text-[16px] text-white\" data-kid=\"1-1-1-2-1\" data-name=\"radar logo icon\">radar</span>\n</div>\n<h1 class=\"text-[16px] leading-[22px] font-semibold truncate ml-1\" data-kid=\"1-1-1-3\" data-name=\"page title text\">Job Details</h1>\n</div>\n<img alt=\"Elena Vance profile photo\" class=\"w-8 h-8 rounded-full object-cover shrink-0\" data-kid=\"1-1-2\" data-name=\"applicant profile avatar\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/64?u=elena-vance\"/>\n</header>\n<main class=\"flex-1 flex flex-col gap-3 px-4 pb-4\" data-kid=\"1-2\" data-name=\"main job details content\">\n<section class=\"bg-white rounded-[12px] p-4 border border-[#bec9c8]/40 flex flex-col gap-2\" data-kid=\"1-2-1\" data-name=\"job overview card container\">\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-1-1\" data-name=\"job status meta row\">\n<div class=\"flex items-center gap-1\" data-kid=\"1-2-1-1-1\" data-name=\"job status badge group\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-[2px] bg-[#e9edff] text-[#3e4948] text-[10px] leading-3 font-medium\" data-kid=\"1-2-1-1-1-1\" data-name=\"verified active status badge\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-[#005454]\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"status indicator dot\"></span>Verified Active\n          </span>\n<span class=\"text-[#3e4948] text-[10px] leading-3 font-medium\" data-kid=\"1-2-1-1-1-2\" data-name=\"discovery time text\">Discovered 3h ago</span>\n</div>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-1-1-2\" data-name=\"source channel label\">via Lever Direct</span>\n</div>\n<div data-kid=\"1-2-1-2\" data-name=\"job title block\">\n<h2 class=\"text-[18px] leading-6 font-semibold tracking-tight\" data-kid=\"1-2-1-2-1\" data-name=\"job title headline\">Staff Product Designer, Systems &amp; AI</h2>\n<div class=\"flex flex-wrap items-center gap-1.5 mt-1 text-[#3e4948] text-[12px] leading-4\" data-kid=\"1-2-1-2-2\" data-name=\"company meta details row\">\n<span class=\"text-[15px] leading-5 font-semibold text-[#141b2b]\" data-kid=\"1-2-1-2-2-1\" data-name=\"company name text\">Linear Labs</span>\n<span data-kid=\"1-2-1-2-2-2\" data-name=\"meta separator dot\">•</span><span data-kid=\"1-2-1-2-2-3\" data-name=\"company funding stage text\">Series B</span><span data-kid=\"1-2-1-2-2-4\" data-name=\"meta separator dot\">•</span><span data-kid=\"1-2-1-2-2-5\" data-name=\"company team size text\">45 team</span><span data-kid=\"1-2-1-2-2-6\" data-name=\"meta separator dot\">•</span><span data-kid=\"1-2-1-2-2-7\" data-name=\"company work arrangement text\">Distributed</span>\n</div>\n</div>\n<div class=\"bg-[#f1f3ff] rounded-[8px] p-3 flex flex-col gap-2 mt-1\" data-kid=\"1-2-1-3\" data-name=\"compensation &amp; location card\">\n<div class=\"flex items-start gap-2\" data-kid=\"1-2-1-3-1\" data-name=\"compensation row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-1-3-1-1\" data-name=\"payments icon\">payments</span>\n<div class=\"flex flex-col\" data-kid=\"1-2-1-3-1-2\" data-name=\"compensation text block\">\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#3e4948] uppercase tracking-wider\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"compensation field label\">Target Compensation</span>\n<span class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-1-3-1-2-2\" data-name=\"compensation amount value\">$175,000 – $210,000 USD <span class=\"text-[12px] leading-4 font-normal text-[#3e4948]\" data-kid=\"1-2-1-3-1-2-2-1\" data-name=\"equity component of compensation\">+ 0.15% Equity</span></span>\n</div>\n</div>\n<div class=\"flex items-start gap-2\" data-kid=\"1-2-1-3-2\" data-name=\"location policy row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-1-3-2-1\" data-name=\"globe location icon\">public</span>\n<div class=\"flex flex-col\" data-kid=\"1-2-1-3-2-2\" data-name=\"location policy text block\">\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#3e4948] uppercase tracking-wider\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"location field label\">Location Policy</span>\n<span class=\"text-[13px] leading-[18px]\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"location policy description\">100% Remote • Any Timezone with 4h UTC overlap</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"bg-white rounded-[12px] p-4 border border-[#bec9c8]/40 flex flex-col gap-3\" data-kid=\"1-2-2\" data-name=\"job match reason card\">\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-2-1\" data-name=\"match card header row\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1\" data-name=\"match header title group\">\n<span class=\"msym text-[20px] text-[#005454]\" data-kid=\"1-2-2-1-1-1\" data-name=\"sparkle match icon\">auto_awesome</span>\n<h3 class=\"text-[16px] leading-[22px] font-semibold\" data-kid=\"1-2-2-1-1-2\" data-name=\"match card title\">Why This Matched</h3>\n</div>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#b7eaff] text-[#004e61] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-2-1-2\" data-name=\"match percentage badge\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"checkmark badge icon\">verified</span>94% Match\n        </span>\n</div>\n<div class=\"flex flex-col gap-2.5\" data-kid=\"1-2-2-2\" data-name=\"match factor list\">\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-2-2-2-1\" data-name=\"role level match row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-2-2-1-1\" data-name=\"checkmark match icon\">check_circle</span>\n<div class=\"flex-1 text-[12px] leading-4\" data-kid=\"1-2-2-2-1-2\" data-name=\"role level match text\">\n<strong class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"role level factor label\">Role Level:</strong> Matches your Staff / Lead criterion <span class=\"text-[#3e4948]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"role level weight note\">(Weight: High)</span>\n</div>\n</div>\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-2-2-2-2\" data-name=\"compensation match row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-2-2-2-1\" data-name=\"checkmark match icon\">check_circle</span>\n<div class=\"flex-1 text-[12px] leading-4\" data-kid=\"1-2-2-2-2-2\" data-name=\"compensation match text\">\n<strong class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"compensation factor label\">Compensation:</strong> Base exceeds your specified $150k target floor by +16.6%\n          </div>\n</div>\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-2-2-2-3\" data-name=\"work mode match row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-2-2-3-1\" data-name=\"checkmark match icon\">check_circle</span>\n<div class=\"flex-1 text-[12px] leading-4\" data-kid=\"1-2-2-2-3-2\" data-name=\"work mode match text\">\n<strong class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"work mode factor label\">Work Mode:</strong> Verified async-first cadence with minimal synchronous rituals\n          </div>\n</div>\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-2-2-2-4\" data-name=\"core competencies match row\">\n<span class=\"msym text-[18px] text-[#005454] shrink-0 mt-0.5\" data-kid=\"1-2-2-2-4-1\" data-name=\"checkmark match icon\">check_circle</span>\n<div class=\"flex-1 text-[12px] leading-4\" data-kid=\"1-2-2-2-4-2\" data-name=\"core competencies match text\">\n<strong class=\"text-[15px] leading-5 font-semibold\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"core competencies factor label\">Core Competencies:</strong> High intersection with your Figma tokens &amp; systems architecture portfolio\n          </div>\n</div>\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-2-2-2-5\" data-name=\"timezone caveat row\">\n<span class=\"msym text-[18px] text-[#3e4c60] shrink-0 mt-0.5\" data-kid=\"1-2-2-2-5-1\" data-name=\"warning icon\">warning</span>\n<div class=\"flex-1 text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-2-2-5-2\" data-name=\"timezone caveat text\">\n<strong class=\"text-[15px] leading-5 font-semibold text-[#141b2b]\" data-kid=\"1-2-2-2-5-2-1\" data-name=\"timezone factor label\">Timezone:</strong> Requires 3h overlap with US Eastern (comfortably within your 4h tolerance)\n          </div>\n</div>\n</div>\n</section>\n<section class=\"bg-white rounded-[12px] p-4 border border-[#bec9c8]/40 flex flex-col gap-3\" data-kid=\"1-2-3\" data-name=\"skills assessment card\">\n<div class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-3-1\" data-name=\"skills card header row\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-1\" data-name=\"skills header title group\">\n<span class=\"msym text-[20px] text-[#005454]\" data-kid=\"1-2-3-1-1-1\" data-name=\"thresholding icon\">data_thresholding</span>\n<h3 class=\"text-[16px] leading-[22px] font-semibold\" data-kid=\"1-2-3-1-1-2\" data-name=\"skills card title\">Skills Assessment</h3>\n</div>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-3-1-2\" data-name=\"sync status label\">Profile Sync: High</span>\n</div>\n<div class=\"flex flex-col gap-2\" data-kid=\"1-2-3-2\" data-name=\"validated skills group\">\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#3e4948] uppercase tracking-wider\" data-kid=\"1-2-3-2-1\" data-name=\"validated skills group label\">Validated in your portfolio (5)</span>\n<div class=\"flex flex-wrap gap-1.5\" data-kid=\"1-2-3-2-2\" data-name=\"validated skills tag row\">\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#a0f0f0] text-[#004f50] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-2-2-1\" data-name=\"design systems skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"skill checkmark icon\">check</span>Design Systems (5+ yrs)\n          </span>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#a0f0f0] text-[#004f50] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-2-2-2\" data-name=\"figma variables skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"skill checkmark icon\">check</span>Figma Variables\n          </span>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#a0f0f0] text-[#004f50] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-2-2-3\" data-name=\"component architecture skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"skill checkmark icon\">check</span>Component Architecture\n          </span>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#a0f0f0] text-[#004f50] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-2-2-4\" data-name=\"design strategy skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"skill checkmark icon\">check</span>Design Strategy\n          </span>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#a0f0f0] text-[#004f50] text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-3-2-2-5\" data-name=\"async communication skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-2-2-5-1\" data-name=\"skill checkmark icon\">check</span>Async Communication\n          </span>\n</div>\n</div>\n<div class=\"flex flex-col gap-2\" data-kid=\"1-2-3-3\" data-name=\"unverified skills group\">\n<span class=\"text-[11px] leading-[14px] font-semibold text-[#3e4948] uppercase tracking-wider\" data-kid=\"1-2-3-3-1\" data-name=\"unverified skills group label\">Unverified or missing mentions (2)</span>\n<div class=\"flex flex-wrap gap-1.5\" data-kid=\"1-2-3-3-2\" data-name=\"unverified skills tag row\">\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#e1e8fd] text-[#3e4948] text-[11px] leading-[14px] font-semibold border border-[#bec9c8]/50\" data-kid=\"1-2-3-3-2-1\" data-name=\"prompt engineering skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"skill question icon\">help</span>Prompt Engineering workflows\n          </span>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-[2px] bg-[#e1e8fd] text-[#3e4948] text-[11px] leading-[14px] font-semibold border border-[#bec9c8]/40\" data-kid=\"1-2-3-3-2-2\" data-name=\"webgl fundamentals skill tag\">\n<span class=\"msym text-[14px]\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"skill question icon\">help</span>WebGL fundamentals\n          </span>\n</div>\n</div>\n</section>\n<section class=\"bg-[#f1f3ff] rounded-[12px] p-3 flex flex-col gap-1.5\" data-kid=\"1-2-4\" data-name=\"job application source card\">\n<div class=\"flex items-center justify-between gap-2 text-[11px] leading-[14px] font-semibold\" data-kid=\"1-2-4-1\" data-name=\"source card info row\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"1-2-4-1-1\" data-name=\"source name group\">\n<span class=\"msym text-[16px] text-[#005454]\" data-kid=\"1-2-4-1-1-1\" data-name=\"link icon\">link</span>Linear Greenhouse / Direct Careers Board\n        </span>\n<span class=\"text-[#005454] shrink-0\" data-kid=\"1-2-4-1-2\" data-name=\"friction level label\">0 friction flow</span>\n</div>\n<p class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-4-2\" data-name=\"source verification description\">Last checked: Today at 09:15 AM. Direct submission endpoint validated with no intermediary recruiter screeners.</p>\n</section>\n<section class=\"bg-[#dce2f7]/70 rounded-[12px] p-3 flex items-start gap-2.5\" data-kid=\"1-2-5\" data-name=\"privacy disclaimer card\">\n<span class=\"msym text-[18px] text-[#3e4c60] shrink-0 mt-0.5\" data-kid=\"1-2-5-1\" data-name=\"privacy tip icon\">privacy_tip</span>\n<p class=\"text-[12px] leading-4 text-[#3e4948]\" data-kid=\"1-2-5-2\" data-name=\"disclaimer text\"><strong class=\"text-[#141b2b] font-semibold\" data-kid=\"1-2-5-2-1\" data-name=\"disclaimer bold title\">RemoteScout direct guarantee:</strong> We are strictly your personal filter and strategy tracker. We never submit applications on your behalf. You apply directly with the employer.</p>\n</section>\n</main>\n<div class=\"shrink-0 bg-white border-t border-[#bec9c8]/40 px-4 py-2 flex flex-col gap-2\" data-kid=\"1-3\" data-name=\"action bar footer\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-3-1\" data-name=\"action button group\">\n<button class=\"flex-1 h-11 bg-[#005454] text-white rounded-[8px] text-[13px] leading-4 font-semibold flex items-center justify-center gap-2\" data-kid=\"1-3-1-1\" data-name=\"plan to apply button\" type=\"button\">\n<span class=\"msym text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"calendar add icon\">calendar_add_on</span><span data-kid=\"1-3-1-1-2\" data-name=\"plan to apply label\">Plan to Apply</span>\n</button>\n<button aria-label=\"Save this job\" class=\"w-11 h-11 bg-[#e9edff] rounded-[8px] flex items-center justify-center\" data-kid=\"1-3-1-2\" data-name=\"save job button\" type=\"button\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-1-2-1\" data-name=\"bookmark icon\">bookmark_border</span>\n</button>\n<button aria-label=\"Report listing expired\" class=\"w-11 h-11 bg-[#e9edff] rounded-[8px] text-[#3e4948] flex items-center justify-center\" data-kid=\"1-3-1-3\" data-name=\"report job button\" type=\"button\">\n<span class=\"msym text-[20px]\" data-kid=\"1-3-1-3-1\" data-name=\"flag icon\">flag</span>\n</button>\n</div>\n<a class=\"h-9 w-full bg-[#f1f3ff] rounded-[8px] text-[11px] leading-[14px] font-semibold flex items-center justify-center gap-1.5\" data-kid=\"1-3-2\" data-name=\"view original listing link\" href=\"#\">\n<span data-kid=\"1-3-2-1\" data-name=\"listing link label\">View Original Listing on Linear.app</span>\n<span class=\"msym text-[14px]\" data-kid=\"1-3-2-2\" data-name=\"external link arrow icon\">north_east</span>\n</a>\n</div>\n</div>",

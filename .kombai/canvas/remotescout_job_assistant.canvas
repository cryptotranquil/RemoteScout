data-kid=\"1-2-3-2-2\" data-name=\"skills list container\">\n<div class=\"flex items-center justify-between px-2.5 py-2 rounded-[8px] bg-[#f1f3ff]\" data-kid=\"1-2-3-2-2-1\" data-name=\"skill item row\">\n<div class=\"flex flex-col\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"skill name and weight stack\">\n<span class=\"text-[12px] leading-4 font-semibold\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"skill name text\">Figma</span>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"skill weight descriptor\">Primary Core • Weight High</span>\n</div>\n<span class=\"msym text-[16px] text-[#3e4948]\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"drag reorder handle icon\">drag_indicator</span>\n</div>\n<div class=\"flex items-center justify-between px-2.5 py-2 rounded-[8px] bg-[#f1f3ff]\" data-kid=\"1-2-3-2-2-2\" data-name=\"skill item row\">\n<div class=\"flex flex-col\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"skill name and weight stack\">\n<span class=\"text-[12px] leading-4 font-semibold\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"skill name text\">Design Systems</span>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"skill weight descriptor\">Primary Core • Weight High</span>\n</div>\n<span class=\"msym text-[16px] text-[#3e4948]\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"drag reorder handle icon\">drag_indicator</span>\n</div>\n<div class=\"flex items-center justify-between px-2.5 py-2 rounded-[8px] bg-[#f1f3ff]\" data-kid=\"1-2-3-2-2-3\" data-name=\"skill item row\">\n<div class=\"flex flex-col\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"skill name and weight stack\">\n<span class=\"text-[12px] leading-4 font-semibold\" data-kid=\"1-2-3-2-2-3-1-1\" data-name=\"skill name text\">Design Strategy</span>\n<span class=\"text-[10px] leading-3 font-medium text-[#3e4948]\" data-kid=\"1-2-3-2-2-3-1-2\" data-name=\"skill weight descriptor\">Secondary • Weight Medium</span>\n</div>\
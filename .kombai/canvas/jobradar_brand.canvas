      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');\n  .font-board { font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif; font-feature-settings: 'tnum' 1; }\n</style>\n<div class=\"font-board flex min-h-screen flex-col bg-[#005454] px-14 py-12 text-[#A0F0F0] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<svg aria-hidden=\"true\" class=\"absolute\" data-kid=\"1-1\" data-name=\"hidden SVG symbol definitions\" height=\"0\" width=\"0\">\n<defs>\n<g id=\"mark-c\">\n<path d=\"M97 41H41V97\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"miter\" stroke-width=\"18\"></path>\n<path d=\"M143 41H199V97\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"miter\" stroke-width=\"18\"></path>\n<path d=\"M41 143V199H97\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"miter\" stroke-width=\"18\"></path>\n<path d=\"M199 143V199H143\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"miter\" stroke-width=\"18\"></path>\n<rect fill=\"currentColor\" height=\"52\" width=\"52\" x=\"94\" y=\"94\"></rect>\n</g>\n<g id=\"mark-c-tile\">\n<rect fill=\"currentColor\" height=\"240\" opacity=\"0.14\" rx=\"53\" width=\"240\"></rect>\n<use href=\"#mark-c\"></use>\n</g>\n</defs>\n</svg>\n<div class=\"flex flex-1 items-center gap-14\" data-kid=\"1-2\" data-name=\"main content row\">\n<!-- construction plate -->\n<div class=\"shrink-0 text-[#A0F0F0]\" data-kid=\"1-2-1\" data-name=\"construction plate container\">\n<svg aria-label=\"JobRadar reticle construction plate\" class=\"h-[620px] w-[620px]\" data-kid=\"1-2-1-1\" data-name=\"reticle construction plate diagram\" role=\"img\" viewbox=\"0 0 480 480\">\n<g stroke=\"#A0F0F0\" stroke-opacity=\"0.13\" stroke-width=\"1\">\n<path d=\"M48 0V480M96 0V480M144 0V480M192 0V480M240 0V480M288 0V480M336 0V480M384 0V480M432 0V480\"></path>\n<path d=\"M0 48H480M0 96H480M0 144H480M0 192H480M0 240H480M0 288H480M0 336H480M0 384H480M0 43